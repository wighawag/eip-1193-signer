{
	"name": "@eip-1193/signer",
	"version": "0.4.1",
	"description": "generic signer for eip-1193 providers",
	"keywords": [
		"eip-1193",
		"ethereum",
		"signer",
		"provider",
		"private-key",
		"mnemonic",
		"viem"
	],
	"author": "wighawag <wighawag@gmail.com>",
	"homepage": "https://github.com/wighawag/eip-1193-signer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/eip-1193-signer.git"
	},
	"bugs": {
		"url": "https://github.com/wighawag/eip-1193-signer/issues"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"pkgroll": "^2.11.2",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"eip-1193": "^0.7.4",
		"viem": "^2.23.12"
	},
	"scripts": {
		"build": "rimraf dist && pkgroll --sourcemap",
		"dev": "pkgroll --watch",
		"release:ci": "pnpm test && pnpm changeset publish",
		"test": "pnpm build && node --test test/*.test.mjs"
	}
}
